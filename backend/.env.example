# Copy this file to .env and fill in the values (the start script does this for you). Never commit .env.

# ---- Auth0 (from your Auth0 dashboard — see README "Set up Auth0")
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://society-api

# Admin login(s): the email address(es) you sign in to Auth0 with, comma-separated
ADMIN_EMAILS=you@example.com

# Long random secret (used only for the dashboard's live feed). Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where the resident app and admin dashboard are opened from (exact addresses, comma-separated)
ALLOWED_ORIGINS=http://localhost:5500

# Order alerts on your phone via Telegram (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true = shows the API test page at /docs. Set false when you go live.
DEV_MODE=true
