# Copy to .env and fill in. Every setting is read with the SR_ prefix.
SR_ENV=dev
SR_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/society_register

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SR_JWT_SECRET=change-me-change-me-change-me-change-me
SR_OTP_SECRET=change-me-too-change-me-too-change-me-too

# Payments
SR_MAKER_CHECKER=true          # whoever raises a payment can't approve it
SR_APPROVALS_REQUIRED=2

# Notifications: "console" prints codes and reminders to the server log (dev)
SR_SMS_PROVIDER=console        # console | msg91
SR_EMAIL_PROVIDER=console      # console | ses
SR_MSG91_AUTH_KEY=
SR_MSG91_SENDER_ID=
SR_MSG91_FLOW_ID=              # DLT-approved template with one ##body## variable
SR_SES_FROM_ADDRESS=
SR_AWS_REGION=ap-south-1

SR_S3_BUCKET=
SR_CORS_ORIGINS=["http://localhost:5173"]
